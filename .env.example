# ============================================================
# وادينا — متغيرات البيئة المطلوبة
# انسخ هذا الملف إلى .env وأضف قيمك الحقيقية
# ============================================================

# ─── قاعدة البيانات (PostgreSQL) — مطلوب ───────────────────
# المشروع يستخدم PostgreSQL خالص عبر drizzle-orm/node-postgres
#
# الخيار 1: Supabase (مجاني، موصى به)
#   1. أنشئ مشروعاً على https://supabase.com
#   2. Settings → Database → Connection string → URI
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# الخيار 2: Neon (مجاني، serverless-friendly)
#   1. أنشئ مشروعاً على https://neon.tech
#   2. Dashboard → Connection Details → Connection string
#   DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/[DB]?sslmode=require
#
# الخيار 3: Local PostgreSQL
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wadina
#
DATABASE_URL=

# ─── بعد إضافة DATABASE_URL، شغّل: ──────────────────────────
#   npx drizzle-kit push      ← ينشئ الجداول في قاعدة البيانات
#   npx tsx src/db/seed.ts    ← يملأ البيانات الأساسية

# ─── OpenRouter AI — مطلوب للشات الذكي ─────────────────────
# احصل على مفتاح مجاني من https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ─── اختياري: للإحصاءات في OpenRouter ──────────────────────
# OPENROUTER_SITE_URL=https://wadina.app
